# Port the app listens on (HTTP + WebSockets on the same port).
PORT=3000

# Public base URL used for the QR code / join link, e.g. https://bracket.example.com
# Leave empty to derive it from the request (honours X-Forwarded-Proto/Host behind a proxy).
PUBLIC_URL=

# Optional password required to create rooms. Joining a room never needs it.
# Leave empty to let anyone create rooms.
HOST_PASSWORD=

# How many reverse proxies sit in front of the app (Express "trust proxy").
# 1 = one proxy (the usual setup). Use 2 if another layer such as a CDN sits in front of it,
# or a list of trusted IPs/subnets.
TRUST_PROXY=1

# Where uploaded images are stored (one sub-folder per room). Defaults to /data in
# production and ./data in development.
DATA_DIR=./data

# Rooms (and their images) are deleted after this many hours without activity.
ROOM_TTL_HOURS=6

# Server-side upload limit per image (images are also downscaled to ~1600px client-side).
MAX_UPLOAD_MB=5

# Safety limits.
MAX_ROOMS=200
MAX_PLAYERS_PER_ROOM=100

# Durations (ms) of the winner reveal and the bracket overview between matches.
REVEAL_MS=5000
OVERVIEW_MS=4000
